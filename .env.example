# ============================================================
# MKP 环境变量模板
# 用法：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
# 注意：这些变量需要配置为「进程环境变量」，
#      其中 JWT_SECRET 由代码通过 System.getenv() 读取，不是 Spring 配置项。
# ============================================================

# --- MySQL ---
# 8 个服务的 application.yaml 都读取此变量作为数据库密码
# 地址 / 用户名在各服务 yaml 中固定为 127.0.0.1:3306 / root
DB_PASSWORD=

# --- JWT ---
# 未设置时代码会回退到内置开发默认值，生产环境必须设置
JWT_SECRET=

# --- DeepSeek ---
# mkp-chatbot（对话与 ReAct 推理）、mkp-pet-service（养护建议）
DEEPSEEK_API_KEY=

# --- 阿里云 DashScope ---
# mkp-chatbot 向量化调用（text-embedding-v3，1024 维）
DASHSCOPE_API_KEY=

# --- 阿里云 OSS ---
# mkp-post / mkp-user / mkp-pet 的图片上传
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=

# ============================================================
# 以下为可选配置，不设置时使用默认值
# ============================================================

# Elasticsearch 地址
# ES_URI=http://127.0.0.1:9200

# ES 全文检索开关；设为 false 时检索降级为 MySQL LIKE
# ES_SEARCH_ENABLED=true
